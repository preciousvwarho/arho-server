NODE_ENV=development
PORT=3000
DATABASE_URL=mongodb://localhost:27017/trash4cash
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
GOOGLE_CLIENT_ID=

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# VTPass utility payments
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_SECRET_KEY=

# Flutterwave transfers
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_BASE_URL=https://api.flutterwave.com/v3

# SMTP email verification
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@trash4cash.com

# Local seed admin
SEED_ADMIN_NAME=Super Administrator
SEED_ADMIN_EMAIL=admin@trash4cash.local
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=
